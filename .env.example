# Copy to .env and `source .env`.
#
# Every line is exported: a bare NAME=value assignment sets a *shell* variable
# that child processes never see, so `source .env` would appear to work and the
# app would still read its defaults.

# Postgres is the only hard dependency.
# Homebrew's postgres makes your macOS username the superuser, with no password:
#   export LEDGERFLOW_DATABASE_URL="postgresql://$(whoami)@localhost:5432/ledgerflow"
# docker compose uses the credentials in docker-compose.yml:
export LEDGERFLOW_DATABASE_URL="postgresql://ledgerflow:ledgerflow@localhost:5432/ledgerflow"

# Optional. Without it the rate limiter falls back to Postgres rather than
# silently becoming unlimited.
export LEDGERFLOW_REDIS_URL="redis://localhost:6379/0"

# "pg" runs the event stream on Postgres; "kafka" uses a broker. Consumers do
# not know which is in use.
export LEDGERFLOW_STREAM=pg
export LEDGERFLOW_KAFKA_BROKERS=localhost:9092

export LEDGERFLOW_RATE_LIMIT=600
