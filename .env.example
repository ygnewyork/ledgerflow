# Copy to .env and edit, or let `make env` / `make brew-pg-5433` write it.
#
# Read by BOTH `make` (via -include) and your shell (via `source .env`), so the
# same file configures a make target and a bare `python -m ledgerflow.cli`.
#
# No quotes around values. A shell tolerates them; Make would keep them as part
# of the value and hand the app a URL wrapped in quote marks.

# Homebrew postgres, default port:
export LEDGERFLOW_DATABASE_URL=postgresql://YOURUSERNAME@localhost:5432/ledgerflow

# Homebrew postgres moved aside because another install owns 5432
# (this is what `make brew-pg-5433` writes):
# export LEDGERFLOW_DATABASE_URL=postgresql://YOURUSERNAME@localhost:5433/ledgerflow

# An EDB / Postgres.app install, which wants the postgres user and a password:
# export LEDGERFLOW_DATABASE_URL=postgresql://postgres:YOURPASSWORD@localhost:5432/ledgerflow

# Optional. Without it the rate limiter falls back to Postgres.
export LEDGERFLOW_REDIS_URL=redis://localhost:6379/0

# "pg" runs the event stream on Postgres; "kafka" uses a broker.
export LEDGERFLOW_STREAM=pg
export LEDGERFLOW_RATE_LIMIT=600
